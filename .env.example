# =============================================================================
# Supabase — credenciais do projeto (copie para .env.local e preencha)
# =============================================================================
# Encontre estes valores em: Supabase Dashboard > Project Settings > API
#
# A "anon key" é pública por design (protegida por Row Level Security no banco).
# NÃO use aqui a "service_role key".

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui
